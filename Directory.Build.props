<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <Company>TIA Engineering Studio</Company>
    <Product>TIA Engineering Studio</Product>
    <Version>0.1.0</Version>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- .NET Framework 4.8 célhoz Linuxon/CI-ben is fordítható referencia-assemblyk -->
    <NetFxRefAssembliesVersion>1.0.3</NetFxRefAssembliesVersion>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="$(NetFxRefAssembliesVersion)" PrivateAssets="all" />
  </ItemGroup>
</Project>
