<Project Sdk="Microsoft.NET.Sdk">
  <!-- Python-folyamat, Rust DLL, fájltárolás, registry-verziófelderítés, worker IPC. Siemens-referencia nincs. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>TiaStudio.Infrastructure</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Application\TiaStudio.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- A felület magyar hibaszövegei és teendői: a közös hibakatalógus (egy forrás a C#/Python/Rust kódokkal) -->
    <EmbeddedResource Include="..\..\..\contracts\error-codes.json" LogicalName="TiaStudio.error-codes.json" Link="Localization\error-codes.json" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="10.0.14" />
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
  </ItemGroup>
</Project>
