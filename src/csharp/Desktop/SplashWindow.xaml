<Window x:Class="TiaStudio.Desktop.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TIA Engineering Studio" Width="720" Height="540"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True" Icon="Assets/app.ico"
        FontFamily="Segoe UI" UseLayoutRounding="True">
    <Window.Resources>
        <CubicEase x:Key="EaseOut" EasingMode="EaseOut" />
        <CubicEase x:Key="EaseInOut" EasingMode="EaseInOut" />
        <BackEase x:Key="Pop" EasingMode="EaseOut" Amplitude="0.3" />

        <!--
            1. fázis: az ikon beugrik, felragyog, fénycsík fut át rajta.
            2. fázis: az ikon felcsúszik a teljes logó ikonjának helyére, és átúszik a teljes logóba;
               a felirat (TIA / ENGINEERING / STUDIO) fentről lefelé tárul fel.
            A célpozíció (95% méret, a logóméret 10,9%-ával feljebb) a két logókép illesztéséből adódik.
        -->
        <Storyboard x:Key="Intro" Duration="0:0:3.3">
            <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.35" />

            <DoubleAnimation Storyboard.TargetName="MarkHost" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.10" Duration="0:0:0.45" />
            <DoubleAnimation Storyboard.TargetName="MarkScale" Storyboard.TargetProperty="ScaleX" From="0.5" To="0.86" BeginTime="0:0:0.10" Duration="0:0:0.75" EasingFunction="{StaticResource Pop}" />
            <DoubleAnimation Storyboard.TargetName="MarkScale" Storyboard.TargetProperty="ScaleY" From="0.5" To="0.86" BeginTime="0:0:0.10" Duration="0:0:0.75" EasingFunction="{StaticResource Pop}" />
            <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" From="0" To="0.75" BeginTime="0:0:0.35" Duration="0:0:0.6" EasingFunction="{StaticResource EaseOut}" />
            <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0.35" BeginTime="0:0:1.40" Duration="0:0:0.8" EasingFunction="{StaticResource EaseInOut}" />
            <DoubleAnimation Storyboard.TargetName="MarkSheenShift" Storyboard.TargetProperty="X" From="-1.2" To="1.2" BeginTime="0:0:0.75" Duration="0:0:0.7" EasingFunction="{StaticResource EaseInOut}" />

            <DoubleAnimation Storyboard.TargetName="MarkScale" Storyboard.TargetProperty="ScaleX" To="0.95" BeginTime="0:0:1.45" Duration="0:0:0.6" EasingFunction="{StaticResource EaseInOut}" />
            <DoubleAnimation Storyboard.TargetName="MarkScale" Storyboard.TargetProperty="ScaleY" To="0.95" BeginTime="0:0:1.45" Duration="0:0:0.6" EasingFunction="{StaticResource EaseInOut}" />
            <DoubleAnimation Storyboard.TargetName="MarkShift" Storyboard.TargetProperty="X" To="3.5" BeginTime="0:0:1.45" Duration="0:0:0.6" EasingFunction="{StaticResource EaseInOut}" />
            <DoubleAnimation Storyboard.TargetName="MarkShift" Storyboard.TargetProperty="Y" To="-37" BeginTime="0:0:1.45" Duration="0:0:0.6" EasingFunction="{StaticResource EaseInOut}" />
            <DoubleAnimation Storyboard.TargetName="FullLogo" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:1.80" Duration="0:0:0.35" />
            <DoubleAnimation Storyboard.TargetName="MarkHost" Storyboard.TargetProperty="Opacity" To="0" BeginTime="0:0:1.90" Duration="0:0:0.35" />
            <DoubleAnimation Storyboard.TargetName="RevealSolid" Storyboard.TargetProperty="Offset" From="0.42" To="1" BeginTime="0:0:1.95" Duration="0:0:0.85" EasingFunction="{StaticResource EaseInOut}" />
            <DoubleAnimation Storyboard.TargetName="RevealFade" Storyboard.TargetProperty="Offset" From="0.52" To="1" BeginTime="0:0:1.95" Duration="0:0:0.85" EasingFunction="{StaticResource EaseInOut}" />
            <DoubleAnimation Storyboard.TargetName="FullSheenShift" Storyboard.TargetProperty="X" From="-1.2" To="1.2" BeginTime="0:0:2.55" Duration="0:0:0.6" EasingFunction="{StaticResource EaseInOut}" />

            <DoubleAnimation Storyboard.TargetName="AccentLine" Storyboard.TargetProperty="Width" From="0" To="200" BeginTime="0:0:2.55" Duration="0:0:0.5" EasingFunction="{StaticResource EaseInOut}" />
            <DoubleAnimation Storyboard.TargetName="Tagline" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:2.65" Duration="0:0:0.45" />
        </Storyboard>

        <!-- Kilépő animáció: finom halványulás és enyhe ráközelítés -->
        <Storyboard x:Key="Outro">
            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.55" EasingFunction="{StaticResource EaseInOut}" />
            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX" To="1.04" Duration="0:0:0.55" EasingFunction="{StaticResource EaseInOut}" />
            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY" To="1.04" Duration="0:0:0.55" EasingFunction="{StaticResource EaseInOut}" />
        </Storyboard>
    </Window.Resources>

    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="RootScale" />
        </Grid.RenderTransform>
        <Border x:Name="Card" Margin="24" CornerRadius="12" Opacity="0">
            <Border.Background>
                <RadialGradientBrush Center="0.5,0.42" GradientOrigin="0.5,0.42" RadiusX="0.75" RadiusY="0.8">
                    <GradientStop Offset="0" Color="#26344A" />
                    <GradientStop Offset="0.6" Color="#18202C" />
                    <GradientStop Offset="1" Color="#10151C" />
                </RadialGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="4" Opacity="0.55" Color="Black" />
            </Border.Effect>
            <Grid ClipToBounds="True">
                <!-- Fogaskerék-vízjel, mint a TIA portál-nézetben -->
                <Path Data="{StaticResource Gear.Watermark}" Fill="#07FFFFFF" Stretch="Uniform" Width="520" Height="460"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-170,-190" />
                <Border Height="3" VerticalAlignment="Top" CornerRadius="12,12,0,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="#003E9AB5" />
                            <GradientStop Offset="0.5" Color="#FF5AA9E6" />
                            <GradientStop Offset="1" Color="#003E9AB5" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Width="340" Height="340">
                        <Ellipse x:Name="Glow" Width="420" Height="420" Margin="-40" Opacity="0" IsHitTestVisible="False">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Offset="0" Color="#665AA9E6" />
                                    <GradientStop Offset="0.45" Color="#223E7CC4" />
                                    <GradientStop Offset="1" Color="#003E7CC4" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>

                        <!-- 2. fázis: teljes logó, fentről lefelé feltáruló felirattal -->
                        <Grid x:Name="FullLogo" Opacity="0">
                            <Grid.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop x:Name="RevealSolid" Offset="0.42" Color="#FF000000" />
                                    <GradientStop x:Name="RevealFade" Offset="0.52" Color="#00000000" />
                                </LinearGradientBrush>
                            </Grid.OpacityMask>
                            <Image Source="{StaticResource Logo.Full}" RenderOptions.BitmapScalingMode="HighQuality" />
                            <!-- fénycsík a feliraton -->
                            <Rectangle IsHitTestVisible="False">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" Opacity="0.5">
                                        <LinearGradientBrush.RelativeTransform>
                                            <TranslateTransform x:Name="FullSheenShift" X="-1.2" />
                                        </LinearGradientBrush.RelativeTransform>
                                        <GradientStop Offset="0.40" Color="#00FFFFFF" />
                                        <GradientStop Offset="0.50" Color="#CCFFFFFF" />
                                        <GradientStop Offset="0.60" Color="#00FFFFFF" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="{StaticResource Logo.Full}" />
                                </Rectangle.OpacityMask>
                                <Rectangle.Clip>
                                    <RectangleGeometry Rect="0,200,340,140" />
                                </Rectangle.Clip>
                            </Rectangle>
                        </Grid>

                        <!-- 1. fázis: ikon -->
                        <Grid x:Name="MarkHost" Width="323" Height="323" Opacity="0" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="MarkScale" ScaleX="0.5" ScaleY="0.5" />
                                    <TranslateTransform x:Name="MarkShift" />
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Image Source="{StaticResource Logo.Image}" RenderOptions.BitmapScalingMode="HighQuality" />
                            <Rectangle IsHitTestVisible="False">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" Opacity="0.55">
                                        <LinearGradientBrush.RelativeTransform>
                                            <TranslateTransform x:Name="MarkSheenShift" X="-1.2" />
                                        </LinearGradientBrush.RelativeTransform>
                                        <GradientStop Offset="0.38" Color="#00FFFFFF" />
                                        <GradientStop Offset="0.50" Color="#CCFFFFFF" />
                                        <GradientStop Offset="0.62" Color="#00FFFFFF" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="{StaticResource Logo.Image}" />
                                </Rectangle.OpacityMask>
                            </Rectangle>
                        </Grid>
                    </Grid>

                    <Border x:Name="AccentLine" Height="2" Width="0" Background="#F39C12" HorizontalAlignment="Center" Margin="0,6,0,0" CornerRadius="1" />
                    <TextBlock x:Name="Tagline" Text="Siemens TIA Portal  V18 · V19 · V20" Foreground="#9FB0C3" FontSize="13"
                               HorizontalAlignment="Center" Margin="0,10,0,0" Opacity="0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
