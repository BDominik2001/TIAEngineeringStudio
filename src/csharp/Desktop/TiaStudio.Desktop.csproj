<Project Sdk="Microsoft.NET.Sdk">
  <!--
    WPF kezelőfelület (.NET Framework 4.8, x64). Siemens- és worker-referencia nincs:
    a TIA-műveletek kizárólag a verziónkénti worker EXE-ken keresztül futnak.
    Windows alatt buildelhető (WPF XAML-fordítás).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AssemblyName>TiaStudio.Desktop</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <RootNamespace>TiaStudio.Desktop</RootNamespace>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <TesRustDll>$(MSBuildThisFileDirectory)..\..\rust\validator\target\release\tes_validator.dll</TesRustDll>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Infrastructure\TiaStudio.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(TesRustDll)" Condition="Exists('$(TesRustDll)')" Link="tes_validator.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
</Project>
