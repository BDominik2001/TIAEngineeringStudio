<Project Sdk="Microsoft.NET.Sdk">
  <!--
    TIA Portal V20 worker (net48, x64), saját V20 Siemens.Engineering.dll referenciával.
    MVP: a közös V18 API-szintű funkciókészletet használja (OpennessShared); V20-specifikus
    API csak ebben a projektben vezethető be, capability flag mögött.
    Nem hivatkozhat a WPF projektre.
  -->
  <PropertyGroup>
    <TiaVersion>V20</TiaVersion>
    <TiaAssemblyVersion>20.0.0.0</TiaAssemblyVersion>
    <TiaApiPath Condition="'$(TiaApiPath)' == ''">C:\Program Files\Siemens\Automation\Portal V20\PublicAPI\V20</TiaApiPath>
  </PropertyGroup>
  <Import Project="..\openness-shared\OpennessWorker.targets" />
</Project>
