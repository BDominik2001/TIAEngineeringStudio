<Project Sdk="Microsoft.NET.Sdk">
  <!--
    TIA Portal V19 worker (net48, x64), saját V19 Siemens.Engineering.dll referenciával.
    MVP: a közös V18 API-szintű funkciókészletet használja (OpennessShared); V19-specifikus
    API csak ebben a projektben vezethető be, capability flag mögött.
    Nem hivatkozhat a WPF projektre.
  -->
  <PropertyGroup>
    <TiaVersion>V19</TiaVersion>
    <TiaAssemblyVersion>19.0.0.0</TiaAssemblyVersion>
    <TiaApiPath Condition="'$(TiaApiPath)' == ''">C:\Program Files\Siemens\Automation\Portal V19\PublicAPI\V19</TiaApiPath>
  </PropertyGroup>
  <Import Project="..\openness-shared\OpennessWorker.targets" />
</Project>
