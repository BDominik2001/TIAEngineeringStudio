<Window x:Class="TiaStudio.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TIA Engineering Studio – TIA Portal V18 / V19 / V20"
        Width="1280" Height="820" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- Állapotsor: munkafolyamat-állapot, célverzió, üzenet -->
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="#FFBBBBBB" Padding="8,4">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Megszakítás" Command="{Binding CancelCommand}" Margin="0" />
                <ProgressBar DockPanel.Dock="Right" Width="120" Height="14" Margin="8,0" IsIndeterminate="{Binding IsBusy}" />
                <TextBlock VerticalAlignment="Center">
                    <Run Text="Állapot: " /><Run Text="{Binding StateText, Mode=OneWay}" FontWeight="Bold" />
                    <Run Text="   Cél: TIA Portal " /><Run Text="{Binding TiaVersion, Mode=OneWay}" FontWeight="Bold" />
                    <Run Text="   " /><Run Text="{Binding StatusMessage, Mode=OneWay}" />
                </TextBlock>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Top" Background="#FFFFF4CE" Padding="8,4">
            <TextBlock TextWrapping="Wrap">
                Csak offline, teljes sandbox-másolatba importál. PLC-letöltés, online kapcsolat, forcing és safety/F-program módosítás ebben a kiadásban nem létezik.
                A generált kódot mérnöknek kell ellenőriznie a gép dokumentációja és kockázatértékelése alapján.
            </TextBlock>
        </Border>

        <TabControl Margin="6">
            <!-- 1. Gépmodell -->
            <TabItem Header="1. Gépmodell">
                <DockPanel Margin="8">
                    <WrapPanel DockPanel.Dock="Top">
                        <Button Content="Új" Command="{Binding NewProjectCommand}" />
                        <Button Content="Megnyitás…" Command="{Binding OpenProjectCommand}" />
                        <Button Content="Mentés…" Command="{Binding SaveProjectCommand}" />
                        <TextBlock VerticalAlignment="Center" Margin="12,0,0,6" Foreground="Gray" Text="{Binding ProjectFilePath}" />
                    </WrapPanel>
                    <GroupBox DockPanel.Dock="Top" Header="Projekt és célrendszer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Projektnév:" Margin="0,4,8,4" VerticalAlignment="Center" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Leírás (ASCII):" Margin="16,4,8,4" VerticalAlignment="Center" />
                            <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding ProjectDescription, UpdateSourceTrigger=PropertyChanged}" Margin="0,2" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="TIA célverzió:" Margin="0,4,8,4" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding TiaVersionOptions}" SelectedItem="{Binding TiaVersion}" Margin="0,2" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="PLC-név:" Margin="16,4,8,4" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding PlcName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="CPU-család:" Margin="0,4,8,4" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding CpuFamilyOptions}" SelectedItem="{Binding CpuFamily}" Margin="0,2" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Margin="16,4,0,4" Foreground="Gray" TextWrapping="Wrap"
                                       Text="A célverzió csak exportcél: ugyanabból a modellből V18, V19 és V20 forrás is előállítható, mindegyik a saját verziójú sandboxba." />
                        </Grid>
                    </GroupBox>
                    <GroupBox Header="Eszközök (munkahengerek) és bemeneti címek">
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Top">
                                <Button Content="+ Munkahenger" Command="{Binding AddCylinderCommand}" />
                                <Button Content="Kijelölt törlése" Command="{Binding RemoveDeviceCommand}" />
                                <TextBlock VerticalAlignment="Center" Margin="8,0,0,6" Foreground="Gray"
                                           Text="Azonosító: CYL_01 forma. Cím: I&lt;bájt&gt;.&lt;bit&gt; (pl. I0.0). Üres felügyeleti idő = 2000 ms." />
                            </WrapPanel>
                            <DataGrid ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" AutoGenerateColumns="False"
                                      CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Azonosító" Width="120" Binding="{Binding Id, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridTextColumn Header="Fajta" Width="90" Binding="{Binding Kind, Mode=OneWay}" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Leírás (ASCII)" Width="*" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridTextColumn Header="Hátsó végállás (bemenet)" Width="160" Binding="{Binding RetractedInput, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridTextColumn Header="Első végállás (bemenet)" Width="160" Binding="{Binding ExtendedInput, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridTextColumn Header="Felügyeleti idő [ms]" Width="140" Binding="{Binding MonitorTimeMs, TargetNullValue='', UpdateSourceTrigger=LostFocus}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </GroupBox>
                </DockPanel>
            </TabItem>

            <!-- 2. Ellenőrzés és generálás -->
            <TabItem Header="2. Ellenőrzés és generálás">
                <DockPanel Margin="8">
                    <WrapPanel DockPanel.Dock="Top">
                        <Button Content="1) Séma- és modellellenőrzés" Command="{Binding ValidateCommand}" />
                        <Button Content="2) Statikus ellenőrzés (Rust)" Command="{Binding CheckCommand}" />
                        <Button Content="3) SCL generálás (Python)" Command="{Binding GenerateCommand}" />
                        <Button Content="Újrakezdés (DRAFT)" Command="{Binding ResetCommand}" />
                    </WrapPanel>
                    <GroupBox Header="Hibák, figyelmeztetések, részletek">
                        <ListBox ItemsSource="{Binding Issues}" FontFamily="Consolas" />
                    </GroupBox>
                </DockPanel>
            </TabItem>

            <!-- 3. Előnézet és jóváhagyás -->
            <TabItem Header="3. Előnézet és jóváhagyás">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="460" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0" Margin="0,0,8,0">
                        <GroupBox DockPanel.Dock="Bottom" Header="Sandbox-projekt és jóváhagyás">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" Foreground="Gray">
                                    <Run Text="Sandbox gyökér: " /><Run Text="{Binding SandboxRoot, Mode=OneWay}" />
                                </TextBlock>
                                <DockPanel Margin="0,6,0,0">
                                    <Button DockPanel.Dock="Right" Content="Tallózás…" Command="{Binding BrowseKnownGoodProjectCommand}" Margin="6,0,0,0" />
                                    <TextBox Text="{Binding KnownGoodProjectPath}" ToolTip="Ismert jó forrásprojekt (nem módosul)" />
                                </DockPanel>
                                <Button Content="Sandbox-másolat készítése" Command="{Binding CreateSandboxCopyCommand}" HorizontalAlignment="Left" Margin="0,6,0,6" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Tallózás…" Command="{Binding BrowseSandboxProjectCommand}" Margin="6,0,0,0" />
                                    <TextBox Text="{Binding SandboxProjectPath, Mode=OneWay}" IsReadOnly="True" ToolTip="A célverzióval egyező (.apXX) sandbox-projekt" />
                                </DockPanel>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="4) Átnéztem a forrásokat" Command="{Binding MarkReviewedCommand}" ToolTip="Minden fájlt meg kell nyitni az előnézetben" />
                                    <Button Content="5) Jóváhagyás" Command="{Binding ApproveCommand}" />
                                </WrapPanel>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Generált fájlok (importálási sorrend)">
                            <ListView ItemsSource="{Binding GeneratedFiles}" SelectedItem="{Binding SelectedFile}">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="#" Width="30" DisplayMemberBinding="{Binding ImportOrder}" />
                                        <GridViewColumn Header="Blokk" Width="170" DisplayMemberBinding="{Binding BlockName}" />
                                        <GridViewColumn Header="Típus" Width="45" DisplayMemberBinding="{Binding BlockType}" />
                                        <GridViewColumn Header="Átnézve" Width="60" DisplayMemberBinding="{Binding Viewed}" />
                                        <GridViewColumn Header="SHA-256" Width="130" DisplayMemberBinding="{Binding Sha256}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </GroupBox>
                    </DockPanel>
                    <GroupBox Grid.Column="1" Header="SCL előnézet (csak olvasható)">
                        <TextBox Style="{StaticResource Mono}" Text="{Binding PreviewText, Mode=OneWay}" />
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- 4. TIA Portal -->
            <TabItem Header="4. TIA Portal">
                <DockPanel Margin="8">
                    <GroupBox DockPanel.Dock="Top" Header="Telepített TIA Portal / Openness verziók (registry)">
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Top">
                                <Button Content="Frissítés" Command="{Binding RefreshInstallationsCommand}" />
                                <Button Content="Worker képességei" Command="{Binding QueryCapabilitiesCommand}" />
                            </WrapPanel>
                            <DataGrid ItemsSource="{Binding Installations}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="150">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Verzió" Width="60" Binding="{Binding TiaVersion}" />
                                    <DataGridTextColumn Header="Állapot" Width="100" Binding="{Binding Status}" />
                                    <DataGridTextColumn Header="Assembly" Width="90" Binding="{Binding AssemblyVersion}" />
                                    <DataGridTextColumn Header="Siemens.Engineering.dll" Width="320" Binding="{Binding EngineeringDllPath}" />
                                    <DataGridTextColumn Header="Megjegyzés" Width="*" Binding="{Binding Notes[0]}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </GroupBox>
                    <WrapPanel DockPanel.Dock="Top">
                        <Button Content="6) Száraz futás (ütközésvizsgálat)" Command="{Binding DryRunCommand}" />
                        <Button Content="7) Import + offline fordítás + mentés" Command="{Binding ImportCommand}" />
                    </WrapPanel>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <GroupBox Grid.Row="0" Grid.Column="0" Header="Worker üzenetek">
                            <ListBox ItemsSource="{Binding WorkerMessages}" FontFamily="Consolas" />
                        </GroupBox>
                        <GroupBox Grid.Row="0" Grid.Column="1" Header="Importterv">
                            <DataGrid ItemsSource="{Binding ImportPlan}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding ImportOrder}" />
                                    <DataGridTextColumn Header="Blokk" Width="*" Binding="{Binding BlockName}" />
                                    <DataGridTextColumn Header="Művelet" Binding="{Binding Action}" />
                                    <DataGridTextColumn Header="Meglévő hely" Width="*" Binding="{Binding ExistingLocation}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                        <GroupBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Header="Fordítási üzenetek (offline)">
                            <DataGrid ItemsSource="{Binding CompileMessages}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Szint" Binding="{Binding Depth}" />
                                    <DataGridTextColumn Header="Állapot" Binding="{Binding State}" />
                                    <DataGridTextColumn Header="Hely" Width="250" Binding="{Binding Path}" />
                                    <DataGridTextColumn Header="Leírás" Width="*" Binding="{Binding Description}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- 5. Napló -->
            <TabItem Header="5. Napló">
                <ListBox Margin="8" ItemsSource="{Binding AuditLines}" FontFamily="Consolas" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
