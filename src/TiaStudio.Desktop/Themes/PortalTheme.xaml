<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                    xmlns:local="clr-namespace:TiaStudio.Desktop">

    <!-- ===================================================================
         TIA Engineering Studio – "Portal" téma
         A TIA Portal portál-nézetének színvilága: sötét fejléc türkiz kiemeléssel,
         palaszürke navigáció narancs kijelöléssel, kékesszürke műveleti panel,
         világosszürke munkaterület.
         =================================================================== -->

    <!-- Színek -->
    <Color x:Key="C.HeaderTop">#0E1215</Color>
    <Color x:Key="C.HeaderBottom">#22282E</Color>
    <Color x:Key="C.Teal">#6FB8CC</Color>
    <Color x:Key="C.TealStrong">#3E9AB5</Color>
    <Color x:Key="C.Orange">#F39C12</Color>
    <Color x:Key="C.OrangeDark">#D9820A</Color>
    <Color x:Key="C.Nav">#3B444D</Color>
    <Color x:Key="C.NavTileTop">#5F6974</Color>
    <Color x:Key="C.NavTileBottom">#4D5661</Color>
    <Color x:Key="C.ActionTop">#334250</Color>
    <Color x:Key="C.ActionBottom">#56697B</Color>
    <Color x:Key="C.Workspace">#D5D9DD</Color>
    <Color x:Key="C.Card">#ECEEF0</Color>
    <Color x:Key="C.Line">#AEB5BD</Color>
    <Color x:Key="C.TextDark">#2B3540</Color>
    <Color x:Key="C.TextMuted">#66717D</Color>
    <Color x:Key="C.TextOnDark">#DDE2E6</Color>
    <Color x:Key="C.TextOnDarkMuted">#9AA6B1</Color>
    <Color x:Key="C.Danger">#C0392B</Color>
    <Color x:Key="C.Success">#3C9D5D</Color>

    <!-- Ecsetek -->
    <LinearGradientBrush x:Key="Brush.Header" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="{StaticResource C.HeaderTop}" />
        <GradientStop Offset="1" Color="{StaticResource C.HeaderBottom}" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.Teal" Color="{StaticResource C.Teal}" />
    <SolidColorBrush x:Key="Brush.TealStrong" Color="{StaticResource C.TealStrong}" />
    <SolidColorBrush x:Key="Brush.Orange" Color="{StaticResource C.Orange}" />
    <SolidColorBrush x:Key="Brush.OrangeDark" Color="{StaticResource C.OrangeDark}" />
    <SolidColorBrush x:Key="Brush.Nav" Color="{StaticResource C.Nav}" />
    <LinearGradientBrush x:Key="Brush.NavTile" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="{StaticResource C.NavTileTop}" />
        <GradientStop Offset="1" Color="{StaticResource C.NavTileBottom}" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.NavTileHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#6E7884" />
        <GradientStop Offset="1" Color="#5A646F" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.NavTileSelected" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#F4F5F6" />
        <GradientStop Offset="1" Color="#D7DBDF" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.ActionPanel" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="{StaticResource C.ActionTop}" />
        <GradientStop Offset="1" Color="{StaticResource C.ActionBottom}" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.Workspace" Color="{StaticResource C.Workspace}" />
    <SolidColorBrush x:Key="Brush.Card" Color="{StaticResource C.Card}" />
    <SolidColorBrush x:Key="Brush.Line" Color="{StaticResource C.Line}" />
    <SolidColorBrush x:Key="Brush.TextDark" Color="{StaticResource C.TextDark}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource C.TextMuted}" />
    <SolidColorBrush x:Key="Brush.TextOnDark" Color="{StaticResource C.TextOnDark}" />
    <SolidColorBrush x:Key="Brush.TextOnDarkMuted" Color="{StaticResource C.TextOnDarkMuted}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource C.Danger}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource C.Success}" />
    <SolidColorBrush x:Key="Brush.Selection" Color="#C9E3EB" />
    <SolidColorBrush x:Key="Brush.Hover" Color="#E1EEF2" />
    <SolidColorBrush x:Key="Brush.Input" Color="#FBFBFC" />
    <LinearGradientBrush x:Key="Brush.Button" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#F7F8F9" />
        <GradientStop Offset="1" Color="#DCE0E4" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.ButtonHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FFFFFF" />
        <GradientStop Offset="1" Color="#E6EEF1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.Accent" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#F8B04A" />
        <GradientStop Offset="1" Color="#E88A0C" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.StartTile" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#C9CED6" />
        <GradientStop Offset="1" Color="#BCC2CC" />
    </LinearGradientBrush>

