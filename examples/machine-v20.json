    },
    {
      "id": "CYL_02",
      "kind": "cylinder",
      "description": "Lift cylinder, station 1",
      "inputs": { "retracted": "I0.2", "extended": "I0.3" },
      "parameters": { "monitor_time_ms": 3000 }
    }
  ]
}
