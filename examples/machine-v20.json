{
  "schema_version": "1.1",
  "project_name": "Demo_Assembly_Cell",
  "description": "Demo assembly cell with two pneumatic cylinders",
  "target": {
    "tia_version": "V20",
    "plc_name": "PLC_1",
    "cpu_family": "S7-1200"
