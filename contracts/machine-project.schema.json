{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tia-engineering-studio.local/contracts/machine-project/1.1",
  "title": "TIA Engineering Studio – verziófüggetlen gépmodell",
  "description": "schema_version 1.1. A szemantikai szabályokat (egyedi azonosítók kis/nagybetűtől függetlenül, I/O-ütközés, CPU-címtartomány, generált névhossz) a docs/VALIDATION_RULES.md írja le; ezeket a C#, Rust és Python validátor egyaránt ellenőrzi.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_name", "target", "devices"],
  "properties": {
    "schema_version": { "const": "1.1" },
    "project_name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
    },
    "description": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^[\\x20-\\x7E]*$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tia_version", "plc_name", "cpu_family"],
      "properties": {
        "tia_version": { "enum": ["V18", "V19", "V20"] },
        "plc_name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_\\-]{0,63}$"
        },
        "cpu_family": { "enum": ["S7-1200", "S7-1500"] }
      }
    },
    "devices": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/device" }
    }
  },
  "$defs": {
    "inputAddress": {
      "type": "string",
      "pattern": "^I(0|[1-9][0-9]{0,4})\\.[0-7]$"
    },
    "device": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"
        },
        "kind": { "enum": ["cylinder"] }
      },
      "oneOf": [ { "$ref": "#/$defs/cylinder" } ]
    },
    "cylinder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "inputs"],
      "properties": {
        "id": true,
        "kind": { "const": "cylinder" },
        "description": {
          "type": "string",
          "maxLength": 120,
          "pattern": "^[\\x20-\\x7E]*$"
        },
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["retracted", "extended"],
          "properties": {
            "retracted": { "$ref": "#/$defs/inputAddress" },
            "extended": { "$ref": "#/$defs/inputAddress" }
          }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "monitor_time_ms": { "type": "integer", "minimum": 100, "maximum": 60000 }
          }
        }
      }
    }
  }
}
