{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tia-engineering-studio.local/contracts/tia-result/1.1",
  "title": "TIA worker eredmény (protocol_version 1.1)",
  "type": "object",
  "required": [
    "protocol_version",
    "job_id",
    "requested_version",
    "actual_version",
    "operation",
    "status",
    "error_count",
    "warning_count",
    "messages",
    "saved_project",
    "sandbox_state"
  ],
  "properties": {
    "protocol_version": {
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "job_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "requested_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "actual_version": {
      "enum": [
        "V18",
        "V19",
        "V20"
      ]
    },
    "operation": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "ValidationOnly",
        "Success",
        "Blocked",
        "Failed",
        "Cancelled",
        "Unsupported"
      ]
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ],
      "description": "contracts/error-codes.json egyik kódja; Success/ValidationOnly esetén null."
    },
    "error_count": {
      "type": "integer",
      "minimum": 0
    },
    "warning_count": {
      "type": "integer",
      "minimum": 0
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "severity",
          "text"
        ],
        "properties": {
          "severity": {
            "enum": [
              "Info",
              "Warning",
              "Error"
            ]
          },
          "code": {
            "type": [
              "string",
              "null"
            ]
          },
          "text": {
            "type": "string"
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "saved_project": {
      "type": "boolean"
    },
    "sandbox_state": {
      "enum": [
        "NotTouched",
        "Unchanged",
        "ModifiedNotSaved",
        "Saved",
        "Unknown"
      ],
      "description": "Unknown: import után megszakadt/elakadt művelet; kézi ellenőrzés és ismert jó másolat visszaállítása szükséges."
    },
    "import_plan": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "required": [
          "import_order",
          "block_name",
          "block_type",
          "relative_path",
          "action"
        ],
        "properties": {
          "import_order": {
            "type": "integer"
          },
          "block_name": {
            "type": "string"
          },
          "block_type": {
            "enum": [
              "FB",
              "FC",
              "DB",
              "UDT",
              "OB"
            ]
          },
          "relative_path": {
            "type": "string"
          },
          "action": {
            "enum": [
              "Create",
              "Collision"
            ]
          },
          "existing_location": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "compile": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "state": {
          "enum": [
            "Success",
            "Information",
            "Warning",
            "Error"
          ]
        },
        "error_count": {
          "type": "integer"
        },
        "warning_count": {
          "type": "integer"
        },
        "messages": {
          "type": "array"
        }
      }
    },
    "capabilities": {
      "type": [
        "object",
        "null"
      ]
    },
    "worker": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "openness_linked": {
          "type": "boolean"
        },
        "engineering_assembly_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "engineering_assembly_version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "started_at_utc": {
      "type": [
        "string",
        "null"
      ]
    },
    "finished_at_utc": {
      "type": [
        "string",
        "null"
      ]
    },
    "blocks": {
      "type": [
        "array",
        "null"
      ],
      "description": "ListBlocks/ExportBlocks: a PLC felhasználói blokkjai és adattípusai.",
      "items": {
        "type": "object",
        "required": [
          "name",
          "block_type",
          "exportable_formats"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "block_type": {
            "enum": [
              "FB",
              "FC",
              "DB",
              "UDT",
              "OB",
              "Unknown"
            ]
          },
          "db_kind": {
            "enum": [
              "Global",
              "Instance",
              "Array",
              null
            ]
          },
          "number": {
            "type": [
              "integer",
              "null"
            ]
          },
          "programming_language": {
            "type": [
              "string",
              "null"
            ]
          },
          "location": {
            "type": [
              "string",
              "null"
            ]
          },
          "is_know_how_protected": {
            "type": "boolean"
          },
          "is_safety": {
            "type": "boolean"
          },
          "is_consistent": {
            "type": "boolean"
          },
          "exportable_formats": {
            "type": "array",
            "items": {
              "enum": [
                "external_source",
                "simaticml"
              ]
            }
          },
          "not_exportable_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "exported_files": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "required": [
          "block_name",
          "block_type",
          "format",
          "relative_path",
          "sha256",
          "byte_length"
        ],
        "properties": {
          "block_name": {
            "type": "string"
          },
          "block_type": {
            "enum": [
              "FB",
              "FC",
              "DB",
              "UDT"
            ]
          },
          "db_kind": {
            "type": [
              "string",
              "null"
            ]
          },
          "programming_language": {
            "type": [
              "string",
              "null"
            ]
          },
          "format": {
            "enum": [
              "external_source",
              "simaticml"
            ]
          },
          "relative_path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "byte_length": {
            "type": "integer"
          }
        }
      }
    }
  }
}
