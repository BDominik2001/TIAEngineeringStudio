{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tia-engineering-studio.local/contracts/generation-manifest/1.1",
  "title": "Generálási / importcsomag-manifest (1.0: Python-generátor, 1.1: könyvtárimport)",
  "type": "object",
  "required": [
    "manifest_version",
    "generator",
    "generator_version",
    "schema_version",
    "project_name",
    "target_tia_version",
    "plc_name",
    "cpu_family",
    "template_set_id",
    "template_set_version",
    "template_set_sha256",
    "run_id",
    "generated_at_utc",
    "source_config_sha256",
    "encoding",
    "line_ending",
    "files",
    "validation_result",
    "safety_scope",
    "download_allowed"
  ],
  "properties": {
    "manifest_version": {
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "generator": {
      "enum": [
        "tes_generator",
        "tes_library"
      ]
    },
    "generator_version": {
      "type": "string"
    },
    "schema_version": {
      "enum": [
        "1.1",
        null
      ],
      "description": "library_import esetén null"
    },
    "project_name": {
      "type": "string"
    },
    "target_tia_version": {
      "enum": [
        "V18",
        "V19",
        "V20"
      ]
    },
    "plc_name": {
      "type": "string"
    },
    "cpu_family": {
      "enum": [
        "S7-1200",
        "S7-1500",
        null
      ]
    },
    "template_set_id": {
      "type": "string"
    },
    "template_set_version": {
      "type": "string"
    },
    "template_set_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "run_id": {
      "type": "string"
    },
    "generated_at_utc": {
      "type": "string"
    },
    "source_config_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "encoding": {
      "enum": [
        "ascii",
        "utf-8"
      ]
    },
    "line_ending": {
      "enum": [
        "CRLF",
        "LF",
        "as-exported"
      ]
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relative_path",
          "sha256",
          "byte_length",
          "block_name",
          "block_type",
          "import_order"
        ],
        "properties": {
          "relative_path": {
            "type": "string",
            "description": "Előre-perjeles relatív út; '..', abszolút út, meghajtóbetű, backslash és symlink tiltott.",
            "pattern": "^(?!/)(?!.*(^|/)\\.\\.?(/|$))[^\\\\:]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "byte_length": {
            "type": "integer",
            "minimum": 0
          },
          "block_name": {
            "type": "string"
          },
          "block_type": {
            "enum": [
              "FB",
              "FC",
              "DB",
              "UDT",
              "OB"
            ]
          },
          "import_order": {
            "type": "integer",
            "minimum": 1
          },
          "format": {
            "enum": [
              "external_source",
              "simaticml"
            ],
            "description": "Csak 1.1-ben; hiányzó érték = external_source. simaticml csak a forrás TIA-verziójába importálható."
          }
        }
      }
    },
    "validation_result": {
      "type": "object"
    },
    "safety_scope": {
      "const": "non-safety"
    },
    "download_allowed": {
      "const": false
    },
    "package_kind": {
      "enum": [
        "generated",
        "library_import"
      ],
      "description": "Csak 1.1-ben; 1.0-ban hiányzik."
    }
  },
  "description": "1.0 esetén a package_kind és a format mező tilos (PackageVerifier)."
}
